# Database
MONGO_DB=mongodb://localhost:27017/sarahah_app
MONGO_DB_CLOUD=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sarahah_app

# Server
PORT=3000

# Encryption
SECRET_KEY=<64-char hex string>
IV=16

# JWT access tokens
JWT_ACCESS_SECRET_USER=
JWT_ACCESS_EXP_USER=1d
JWT_ACCESS_SECRET_ADMIN=
JWT_ACCESS_EXP_ADMIN=30d

# JWT refresh tokens
JWT_REFRESH_SECRET_USER=
JWT_REFRESH_EXP_USER=7d
JWT_REFRESH_SECRET_ADMIN=
JWT_REFRESH_EXP_ADMIN=365d

# CORS
WHITE_LIST_ORIGINS=http://localhost:3000

# Google OAuth
GCP_CLIENT_ID=

# Redis
REDIS_URL=redis://localhost:6379

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=